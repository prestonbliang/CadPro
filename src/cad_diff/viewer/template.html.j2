<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  html, body { margin: 0; height: 100%; background: #1b1d1f; color: #e7e5dc; font: 14px -apple-system, "Segoe UI", sans-serif; }
  #viewer { position: absolute; inset: 0; }
  #viewer canvas { display: block; }
  #panel { position: absolute; top: 16px; left: 16px; background: rgba(24, 26, 28, 0.9); border: 1px solid #3a3d3f;
           border-radius: 8px; padding: 12px 16px; width: min(330px, calc(100vw - 64px)); max-height: calc(100vh - 64px); overflow: auto; backdrop-filter: blur(8px); }
  #panel h1 { font-size: 13px; font-weight: 600; margin: 0 0 4px; }
  #panel p { margin: 0 0 10px; color: #9a9d93; font-size: 12px; }
  .legend-row { display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer; user-select: none; }
  .swatch { width: 12px; height: 12px; border-radius: 2px; flex: none; }
  .viewer-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; margin: 10px 0; padding: 9px 0; border-top: 1px solid #3a3d3f; border-bottom: 1px solid #3a3d3f; }
  .viewer-tools label { display: flex; gap: 7px; align-items: center; color: #c7cbc2; font-size: 12px; cursor: pointer; }
  #model-bounds, #picked-points { font: 11px ui-monospace, SFMono-Regular, Consolas, monospace; color: #b5bac1; line-height: 1.55; white-space: pre-line; }
  #picked-points { margin-top: 8px; color: #76d6c0; }
  #loading { position: absolute; top: 16px; right: 16px; color: #9a9d93; font-size: 12px; }
  @media (max-width: 640px) { #panel { top: 8px; left: 8px; width: min(290px, calc(100vw - 48px)); max-height: 45vh; } #loading { top: auto; right: 8px; bottom: 8px; } }
</style>
</head>
<body>
<div id="viewer"></div>
<div id="panel">
  <h1>{{ title }}</h1>
  <p>Drag to orbit, right-drag to pan, scroll to zoom. Double-click the model to select calibration points.</p>
  <div id="legend"></div>
  <div class="viewer-tools" aria-label="Viewer overlays">
    <label><input id="viewer-grid" type="checkbox" checked> Grid</label>
    <label><input id="viewer-axes" type="checkbox" checked> Axes</label>
    <label><input id="viewer-wireframe" type="checkbox"> Wireframe</label>
    <label><input id="viewer-normals" type="checkbox"> Normal shading</label>
    <label><input id="viewer-texture" type="checkbox" checked> Material / texture</label>
  </div>
  <div id="model-bounds">Bounds: loading...</div>
  <div id="picked-points" aria-live="polite">No calibration point selected.</div>
</div>
<div id="loading">Loading model…</div>

<script type="importmap">
{{ import_map_json }}
</script>
<script>
  window.__CAD_DIFF_GLB_BASE64__ = "{{ glb_base64 }}";
</script>
<script type="module">
{{ viewer_js }}
</script>
</body>
</html>
